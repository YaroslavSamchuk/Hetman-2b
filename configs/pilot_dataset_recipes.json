{
  "experiment_name": "hetman_2b_pilot_200m_abc",
  "total_tokens_per_recipe": 200000000,
  "sequence_length": 4096,
  "total_sequences_per_recipe": 48828,
  "token_accounting": {
    "target_is_exact": true,
    "packing": "concatenate tokenized documents within each source allocation, then emit full 4096-token sequences",
    "final_sequence_policy": "retain an explicit final partial sequence or mask its padding; never count padding toward target_tokens",
    "full_sequences": 48828,
    "remainder_tokens": 512,
    "note": "200,000,000 is not divisible by 4096; 48,828 full sequences contain 199,999,488 tokens plus 512 target tokens. Per-source sequence counts are ceilings for capacity estimates and must not be summed as exact token counts."
  },
  "tokenized_output": {
    "format": "mmap_bin_idx",
    "data_extension": ".bin",
    "index_extension": ".idx",
    "dtype": "uint32",
    "index_fields": ["sequence_offset", "token_count", "source_id", "split"],
    "shard_max_tokens": 1000000000
  },
  "validation_split": {
    "method": "stable_hash_by_source_and_document_id",
    "fraction_per_source": 0.01,
    "seed": 42,
    "split_before_curation": true,
    "deduplicate_validation_against_train": true,
    "keep_benchmark_prompts_out_of_validation": true,
    "perplexity_sets_are_separate_from_zero_shot_benchmarks": true
  },
  "data_root_env_var": "HETMAN_DATA_ROOT",
